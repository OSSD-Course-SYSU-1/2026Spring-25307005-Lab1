            const nanFraction = { numerator: NaN, denominator: NaN };
            return nanFraction;
        }
        const quotientFraction = {
            numerator: f1.numerator * f2.denominator,
            denominator: f1.denominator * f2.numerator
        };
        return this.simplify(quotientFraction);
    }
