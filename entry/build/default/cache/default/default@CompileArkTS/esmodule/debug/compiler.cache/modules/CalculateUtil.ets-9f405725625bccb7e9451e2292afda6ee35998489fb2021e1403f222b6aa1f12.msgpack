        }
        else {
            // Two real roots
            let root1 = (-bNum + Math.sqrt(discriminant)) / (2 * aNum);
            let root2 = (-bNum - Math.sqrt(discriminant)) / (2 * aNum);
            return `xâ‚ = ${root1.toFixed(4)}, xâ‚‚ = ${root2.toFixed(4)}`;
        }
    }
