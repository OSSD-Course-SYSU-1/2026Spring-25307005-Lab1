            return `xâ‚ = ${realPart.toFixed(4)} + ${imagPart.toFixed(4)}i, xâ‚‚ = ${realPart.toFixed(4)} - ${imagPart.toFixed(4)}i`;
        }
        else if (discriminant === 0) {
            // One real root
