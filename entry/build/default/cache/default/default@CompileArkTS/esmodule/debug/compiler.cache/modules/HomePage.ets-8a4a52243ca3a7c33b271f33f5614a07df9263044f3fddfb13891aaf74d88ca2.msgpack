        .justifyContent(FlexAlign.Center)
      }
      .width(CommonConstants.FULL_PERCENT)
      .margin({ bottom: '5vp' })

      // History panel
      if (this.showHistory) {
        Column() {
          // History header
          Row() {
            Text('è®¡ç®—å†å²')
              .fontSize('16vp')
              .fontColor(Color.Black)
              .fontWeight(FontWeight.Bold)
            
            Blank()
            
            Text('æ¸…ç©º')
              .fontSize('14vp')
              .fontColor('#FF0000')
              .onClick(() => {
                HistoryManager.clearHistory();
                this.historyList = [];
              })
          }
          .width('95%')
          .padding({ top: '10vp', bottom: '10vp' })
          
          // History list
          if (this.historyList.length === 0) {
            Column() {
              Text('æš‚æ— å†å²è®°å½•')
