                expressions[index] = (this.mulOrDiv(item.slice(0, item.length - 1), CommonConstants.ONE_HUNDRED, CommonConstants.DIV)).toString();
            }
            // Whether the last digit is an operator.
            if ((index === len - 1) && this.isSymbol(item)) {
