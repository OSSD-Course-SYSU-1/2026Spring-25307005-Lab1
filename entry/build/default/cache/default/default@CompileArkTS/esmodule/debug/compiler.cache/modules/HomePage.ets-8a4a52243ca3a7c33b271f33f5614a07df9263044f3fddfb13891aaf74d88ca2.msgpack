          .justifyContent(FlexAlign.Center)
          .borderRadius(5)
          .onClick(() => {
            this.isFractionMode = !this.isFractionMode;
            // Re-calculate display if there's a result
            if (this.calValue && this.calValue !== 'NaN') {
              this.updateDisplayFormat();
            }
          })

          Blank().width('5%')

          // Scientific mode toggle button
          Column() {
