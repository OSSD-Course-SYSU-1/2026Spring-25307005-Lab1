                .fontColor('#999999')
            }
            .width('95%')
            .height('150vp')
            .justifyContent(FlexAlign.Center)
          } else {
            List() {
              ForEach(this.historyList, (item: HistoryItem, index: number) => {
                ListItem() {
                  Column() {
                    Row() {
                      Text(item.expression)
                        .fontSize('14vp')
                        .fontColor('#333333')
                        .layoutWeight(1)
                      
                      Text('=')
                        .fontSize('14vp')
                        .fontColor('#666666')
                        .margin({ left: '5vp', right: '5vp' })
                      
                      Text(item.result)
