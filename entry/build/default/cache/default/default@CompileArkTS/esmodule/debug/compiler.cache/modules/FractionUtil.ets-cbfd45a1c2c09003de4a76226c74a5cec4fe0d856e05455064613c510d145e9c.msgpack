        return nanFraction;
    }
    /**
     * Convert fraction to string
     *
     * @param fraction Fraction
     * @return String representation
     */
    fractionToString(fraction) {
        const simplified = this.simplify(fraction);
        if (isNaN(simplified.numerator) || isNaN(simplified.denominator)) {
